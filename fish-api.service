[Unit]
Description=Fish Monitoring API Server
After=network.target

[Service]
Type=simple
User=koi
WorkingDirectory=/home/koi/Documents/GitHub/ishara-iot
ExecStart=/bin/bash /home/koi/Documents/GitHub/ishara-iot/start_api_server.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=multi-user.target
