# ─── MediaMTX Streaming Configuration ───

# RTMP target on VPS MediaMTX server
export RTMP_URL=rtmp://187.77.189.5:1935/live/camera

# HLS playback URL (viewers use this)
export HLS_URL=https://mediamtx.koifishfriend.online/live/camera/index.m3u8

# Stream settings
export STREAM_WIDTH=640
export STREAM_HEIGHT=360
export STREAM_FPS=15
export STREAM_BITRATE=800k

# API Server (runs on Pi, serves token/info endpoints)
export API_SERVER_HOST=0.0.0.0
export API_SERVER_PORT=5000
