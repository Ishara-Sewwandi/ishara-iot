# Example dataset configuration for YOLOv8 training
# Save this as fish_dataset.yaml

# Dataset path (absolute or relative to this file)
path: /path/to/your/fish_dataset

# Train/val/test splits
train: images/train
val: images/val
test: images/test  # optional

# Number of classes
nc: 2

# Class names
names:
  0: fish
  1: dead_fish

# Dataset info
# Collect images of:
# - Healthy swimming fish
# - Fish showing mortality signs (side-floating, inactive)
# - Various angles and lighting conditions
# 
# Recommended dataset size:
# - Minimum: 500 images (250 per class)
# - Good: 1000+ images
# - Excellent: 2000+ images
#
# Use tools like:
# - Roboflow (https://roboflow.com)
# - labelImg (https://github.com/tzutalin/labelImg)
# - CVAT (https://cvat.org)
